# Generated datasets, repo root only. Never a bare data/ pattern: it would
# also match jevmark/data/, which holds source code and checked-in descriptions.
# /data/* rather than /data/ so that the one committed file in it can be re-included:
# the fixed baseline evaluation subset (record ids only, task 1.8).
/data/*
!/data/baseline_subset.json
# Raw Kaggle output as downloaded; the reviewed run files are copied to runs/ and committed from there.
/data/kaggle_output/

# Run outputs: adapters and weights are ignored; metrics.json, config.yaml,
# calibration.json and model_id.txt are committed so reports can link to them.
/runs/*/adapter/
/runs/*_limit*/
/runs/*/results.jsonl.gz
/runs/*/replies.jsonl
/runs/*/last/
/runs/*_smoke/
/runs/fast_*/
*.safetensors
*.bin
*.pt

# Secrets
.env

# Environments
.venv/

# Caches and build output
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store
