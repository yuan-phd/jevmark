# Generated datasets, repo root only. Never a bare data/ pattern: it would
# also match jevmark/data/, which holds source code and checked-in descriptions.
/data/

# Run outputs: adapters and weights are ignored; metrics.json, config.yaml,
# calibration.json and model_id.txt are committed so reports can link to them.
/runs/*/adapter/
*.safetensors
*.bin
*.pt

# Secrets
.env

# Environments
.venv/

# Caches and build output
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store
